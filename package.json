{
  "name": "@lorenzh/pulse-console",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Web console of pulse that talks to the pulse-api admin API.",
  "type": "module",
  "private": true,
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit && bun node_modules/typescript7/bin/tsc --noEmit -p e2e",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint . && pulse-workflows",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:browser": "bun e2e/run.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#04108fa0c67d9a79c0f6d1ade4dd78df3ad8a4a7",
    "@types/bun": "1.4.0",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "playwright": "1.64.1",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@lorenzh/pulse-contract": "github:lorenzh/pulse-contract#176fb6ed14b2f14b730a9fd1757239f210f97a29",
    "@lorenzh/pulse-kit": "github:lorenzh/pulse-kit#536133f3e8b708179fa01feeb02395a0e1961e07"
  },
  "packageManager": "bun@1.4.0"
}
